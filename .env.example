# findata Injection service — environment. Copy to .env (gitignored) and fill in.
# These mirror the read service's values so a PAT / local key validates the same
# on both and blob URLs resolve across both.

# Postgres — the SAME warehouse the read service uses.
FINDATA_DB_PASSWORD=changeme

# ClickHouse backend (multi-backend Phase B) — OPTIONAL. Empty = Postgres-only.
# Set the HTTP-interface URL (e.g. http://clickhouse:8123) to allow approving a
# table onto ClickHouse instead of Postgres.
FINDATA_CLICKHOUSE_URL=
FINDATA_CLICKHOUSE_USER=default
FINDATA_CLICKHOUSE_PASSWORD=
FINDATA_CLICKHOUSE_DB=default

# Auth — local-key bypass (comma-separated key:label,key:label). Optional, but
# the read service's MCP write tools authenticate to this service with one of
# these (role=local). Leave empty to require a Lumid PAT for every caller.
FINDATA_API_KEYS=

# Blob plane — keep the public base URL identical to the read service.
FINDATA_BLOB_ROOT=/app/blobs
FINDATA_BLOB_PUBLIC_BASE_URL=https://kv.run:5000
FINDATA_BLOB_MAX_BYTES=104857600

# Lumilake handoff — empty disables the fire-and-forget followup POST.
FINDATA_LUMILAKE_BASE_URL=
FINDATA_LUMILAKE_TOKEN=
