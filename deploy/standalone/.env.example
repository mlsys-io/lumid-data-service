# Copy to .env and fill in. Everything below scopes the whole stack to this folder.
APP_NAME=myapp
APP_IMAGE=lumid-app:latest          # config-only? build from crates/mint-app-bin (see README). Bespoke app? your image.
APP_PORT=5012                       # host port → app :8088

DB_PASSWORD=change-me-strong
DB_NAME=appdb

# Read-only role the retrieval/data-agent SQL path de-escalates to (SET LOCAL ROLE).
# Created by reader_role.sql on first DB boot. Leave as lumid_reader for a secure
# default; blank it to run retrieval with the app pool's full privileges.
RETRIEVAL_DB_ROLE=lumid_reader

MINIO_USER=minioadmin
MINIO_PASSWORD=change-me-strong
BLOB_BUCKET=blobs
MINIO_CONSOLE_PORT=9001

# Local API key(s): "key:label,key:label". Send as: Authorization: Bearer <key>
# A key whose label starts with `sync:` authenticates as a data-push peer (see below).
API_KEYS=devkey:dev

# Data-push / cross-instance sync (optional; needs an app built with ServeParts.enable_sync).
# TARGET (inbox): issue a producer a `sync:<peer>` key above, e.g. ...,synctoken:sync:findata
# PRODUCER (push helper): point at the target and identify this instance:
# LUMID_SYNC_TARGET_URL=https://target.example
# LUMID_SYNC_TARGET_TOKEN=synctoken
# LUMID_SYNC_PEER_ID=findata
# See the platform README "Data migration / cross-instance sync" for the full recipe.
