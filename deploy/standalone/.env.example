# Copy to .env and fill in. Everything below scopes the whole stack to this folder.
APP_NAME=myapp
APP_IMAGE=lumid-app:latest          # config-only? build from crates/mint-app-bin (see README). Bespoke app? your image.
APP_PORT=5012                       # host port → app :8088

DB_PASSWORD=change-me-strong
DB_NAME=appdb

MINIO_USER=minioadmin
MINIO_PASSWORD=change-me-strong
BLOB_BUCKET=blobs
MINIO_CONSOLE_PORT=9001

# Local API key(s): "key:label,key:label". Send as: Authorization: Bearer <key>
API_KEYS=devkey:dev
