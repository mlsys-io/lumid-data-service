# Multi-stage build for the unified Rust (axum) data service.
#
# Stage 1 compiles a release binary; the dependency layer is cached by building
# against a stub `main.rs` first, so source-only edits skip the (slow) crate
# rebuild. Stage 2 is a slim Debian runtime — the binary is statically linked
# against rustls (no OpenSSL) and bundles zstd/miniz_oxide, so the runtime needs
# only ca-certificates (+ curl for the healthcheck).

FROM rust:1-bookworm AS builder
WORKDIR /build

# --- dependency cache layer -------------------------------------------------
# Copy only the manifests + a stub entrypoint, then build deps. This layer is
# reused as long as Cargo.toml / Cargo.lock don't change.
COPY Cargo.toml Cargo.lock ./
COPY crates/findata/Cargo.toml crates/findata/Cargo.toml
RUN mkdir -p crates/findata/src \
    && echo 'fn main() {}' > crates/findata/src/main.rs \
    && cargo build --release --locked \
    && rm -rf crates/findata/src

# --- real build -------------------------------------------------------------
COPY crates ./crates
# Bust cargo's mtime cache so the real binary recompiles (deps stay cached).
RUN touch crates/findata/src/main.rs \
    && cargo build --release --locked

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/findata /usr/local/bin/findata

# Default bind; overridable via FINDATA_BIND_ADDR.
ENV FINDATA_BIND_ADDR=0.0.0.0:8088
EXPOSE 8088

CMD ["findata"]
